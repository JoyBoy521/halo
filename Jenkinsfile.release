// ═══════════════════════════════════════════════════════════════
// Halo CD 流水线：选一个 Git tag（或镜像 tag），部署到 staging / prod
//
// 与 CI 的分工：
//   CI（halo-ci）= 拉代码 → 测试 → 打镜像 → 推 Harbor → 部署 dev
//   CD（halo-cd）= 选版本  → 部署   → 健康检查 → 台账
//
// 版本来源（二选一，GIT_TAG 优先）：
//   GIT_TAG   —— Git tag 下拉框。前提：Harbor 里有同名镜像
//                （CI 用 tag 触发构建时会自动产出同名镜像 tag）
//   IMAGE_TAG —— 只想按镜像 tag 部署时填这个
//
// 发布和回滚是同一条路径：选旧版本再发一次，就是回滚。
// ═══════════════════════════════════════════════════════════════

pipeline {
    agent any

    parameters {
        // ── 主入口：从 Git tag 选 ──────────────────────────────
        // ⚠️ tagFilter 是 glob 不是正则：'*' 匹配全部；只写 'v*' 会漏掉不带 v 的 tag
        // 前提：Harbor 里有同名镜像（即该 tag 曾经触发过 CI 构建）
        gitParameter(name: 'GIT_TAG',
                     type: 'PT_TAG',
                     tagFilter: '*',
                     sortMode: 'DESCENDING_SMART',
                     defaultValue: '',
                     description: '从 Git tag 选要部署的版本（需 Harbor 里有同名镜像）')

        // ── 备用：直接按镜像 tag 部署 ──────────────────────────
        string(name: 'IMAGE_TAG',
               defaultValue: '',
               description: '（可选）直接填镜像 tag；填了则优先用它，忽略上面的 GIT_TAG')

        choice(name: 'TARGET_ENV',
               choices: ['staging', 'prod'],
               description: '部署到哪个环境（dev 由 CI 自动发）')
    }

    environment {
        HOST_IP  = '192.168.187.128'
        REGISTRY = '192.168.187.128:8088'
        PROJECT  = 'halo'
        APP      = 'halo'
        IMAGE    = "${REGISTRY}/${PROJECT}/${APP}"
        // ⚠️ 台账目录必须是【容器里】存在的路径。Jenkins 跑在容器里，
        //    看不到宿主机的 /home/joyboy，直接写那个路径会 Permission denied。
        //    /var/jenkins_home 是已挂载的卷，对应宿主机 /home/joyboy/devops/jenkins
        LEDGER   = '/var/jenkins_home/halo-cd'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        // ── 1. 校验镜像存在 ────────────────────────────────────
        // 不存在就直接停，并列出 Harbor 里现有的 tag ——
        // 免得你去猜"是参数选错了还是镜像真没有"
        stage('校验镜像') {
            steps {
                script {
                    // IMAGE_TAG 填了就优先用它；否则用 GIT_TAG
                    env.DEPLOY_TAG = params.IMAGE_TAG?.trim() ?: params.GIT_TAG?.trim()
                    if (!env.DEPLOY_TAG) {
                        error('GIT_TAG 和 IMAGE_TAG 都没选 —— 至少选一个。' +
                              '如果 GIT_TAG 下拉框是空的，说明仓库还没有 Git tag：' +
                              'git tag -a v1.0.0 -m "第一个正式版" && git push origin v1.0.0')
                    }
                    echo "本次部署版本 = ${env.DEPLOY_TAG}"
                }

                withCredentials([usernamePassword(credentialsId: 'harbor-cred',
                                                  usernameVariable: 'HARBOR_USER',
                                                  passwordVariable: 'HARBOR_PASS')]) {
                    // 单引号块：Groovy 不展开，$HARBOR_PASS 由 shell 从环境变量读，密码不进日志
                    sh 'echo "$HARBOR_PASS" | docker login ' + REGISTRY + ' -u "$HARBOR_USER" --password-stdin'

                    sh '''
                    if docker pull ${IMAGE}:${DEPLOY_TAG}; then
                      echo "镜像存在，继续"
                    else
                      echo "Harbor 里没有 ${IMAGE}:${DEPLOY_TAG}，现有 tag："
                      curl -s -u "$HARBOR_USER:$HARBOR_PASS" \
                        "http://${REGISTRY}/api/v2.0/projects/${PROJECT}/repositories/${APP}/artifacts?page_size=20&with_tag=true" \
                        | grep -oE '"name":"[^"]*"' | sort -u | head -20
                      echo "→ 先去跑 halo-ci 把镜像建出来，或换一个已存在的 tag"
                      exit 1
                    fi
                    '''
                }
            }
        }

        // ── 2. 记录回滚点 ──────────────────────────────────────
        // 回滚点记在"部署前"。所以某环境第一次发布时是 none，
        // 想练回滚得先发两个版本
        stage('记录回滚点') {
            steps {
                sh '''
                mkdir -p ${LEDGER}/backup/${TARGET_ENV}

                CURRENT=$(docker inspect ${APP}-${TARGET_ENV} \
                          --format "{{index .Config.Image}}" 2>/dev/null | sed 's/.*://') || true
                CURRENT=${CURRENT:-none}
                echo "$CURRENT" > ${LEDGER}/last_good_${TARGET_ENV}.txt

                echo "$(date '+%F %T') | 部署前回滚点 | ${TARGET_ENV} | running=${CURRENT} | 即将部署=${DEPLOY_TAG}" \
                  >> ${LEDGER}/deployments.log
                echo "回滚点已记录：${TARGET_ENV} 当前跑的是 ${CURRENT}"
                '''
            }
        }

        // ── 3. 人工审批（只有 prod 才需要）────────────────────
        stage('人工审批') {
            when { expression { params.TARGET_ENV == 'prod' } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "确认把 ${env.DEPLOY_TAG} 发布到 PROD（8092）？",
                          ok: '确认发布',
                          submitter: 'admin'
                }
            }
        }

        // ── 4. 部署 ────────────────────────────────────────────
        // 端口：staging=8091 / prod=8092；容器内固定 8090
        // 数据卷：每个环境独立，否则数据互相污染
        stage('部署') {
            steps {
                script {
                    env.HOST_PORT = (params.TARGET_ENV == 'prod') ? '8092' : '8091'
                }
                sh '''
                echo "=== 部署 ${DEPLOY_TAG} → ${TARGET_ENV}（宿主机 ${HOST_PORT}）==="

                docker rm -f ${APP}-${TARGET_ENV} 2>/dev/null || true

                docker run -d \
                  --name ${APP}-${TARGET_ENV} \
                  -p ${HOST_PORT}:8090 \
                  -v ${APP}-work-${TARGET_ENV}:/root/.halo2 \
                  -e APP_ENV=${TARGET_ENV} \
                  -e APP_VERSION=${DEPLOY_TAG} \
                  ${IMAGE}:${DEPLOY_TAG}
                '''
            }
        }

        // ── 5. 健康检查 ────────────────────────────────────────
        // readiness 会把数据库连通性算进去，比"容器 Up"靠谱
        // Halo 首次启动要跑数据库迁移，给足 3 分钟（36 × 5s）
        stage('健康检查') {
            steps {
                sh '''
                for i in $(seq 1 36); do
                  if curl -fsS "http://${HOST_IP}:${HOST_PORT}/actuator/health/readiness" | grep -q '"status":"UP"'; then
                    echo "${TARGET_ENV} 就绪（第 $i 次检查）"
                    exit 0
                  fi
                  echo "  第 $i 次未就绪，5 秒后重试…"
                  sleep 5
                done

                echo "健康检查失败，容器日志尾部："
                docker logs ${APP}-${TARGET_ENV} --tail 60
                exit 1
                '''
            }
        }

        // ── 6. 写台账 ──────────────────────────────────────────
        stage('写台账') {
            steps {
                sh '''
                echo "$(date '+%F %T') | 部署成功 | ${TARGET_ENV} | ${DEPLOY_TAG} | http://${HOST_IP}:${HOST_PORT} | build=#${BUILD_NUMBER}" \
                  >> ${LEDGER}/deployments.log
                echo "${DEPLOY_TAG}" > ${LEDGER}/current_${TARGET_ENV}.txt
                echo "台账已更新：${LEDGER}/deployments.log"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ ${env.DEPLOY_TAG} 已发布到 ${params.TARGET_ENV}：http://${HOST_IP}:${env.HOST_PORT}"
        }
        failure {
            echo """
            ❌ 部署失败。

            回滚方法：重新运行本 job，IMAGE_TAG 选上一个好版本
             （或选第一项"改用 GIT_TAG"，再用 GIT_TAG 选对应版本）——
              cat ${LEDGER}/last_good_${params.TARGET_ENV}.txt   # 宿主机: /home/joyboy/devops/jenkins/halo-cd/
              cat ${LEDGER}/deployments.log
            """
        }
    }
}
